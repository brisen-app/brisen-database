{
  "scripts": {
    "start": "npx supabase start",
    "upgrade": "deno add npm:supabase --dev --allow-scripts",
    "stop": "npx supabase stop",
    "db:link-dev": "npx supabase link --project-ref tlnldlywflpgvjepxwxz",
    "db:link-prod": "npx supabase link --project-ref bqimlisytxvraplzjnei",
    "db:login": "npx supabase login",
    "db:pull": "supabase db pull --local -s public,extensions,storage,auth",
    "db:reset": "npx supabase db reset --local",
    "db:serve": "npx supabase functions serve --no-verify-jwt --env-file supabase/env.local",
    "db:unlink": "rm -rf supabase/.temp",
    "db:up": "npx supabase migration up"
  },
  "devDependencies": {
    "supabase": "^2.19.7"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  }
}
